# The settings npm run dev and the other scripts read. Copy this file to .env and fill it in; .env stays out of git.
# No Stellar secret key goes here, or anywhere else in this project.

# The account clients pay, in USDC: a public G... address in your own wallet. Leave it empty: npm run launch sets
# one up (mainnet has no throwaway accounts).
PAY_TO=
# Where clients reach this service on this computer. On the server, deploy sets the public https:// address.
PUBLIC_ORIGIN=http://localhost:8787
# The job database: paid jobs live here, so keep it on a disk that survives restarts.
JOB_DB_PATH=./jobs.sqlite
# Your Stellar 8004 agent id: npm run launch saves it.
AGENT_ID=
# The network: stellar:pubnet is mainnet, real USDC. stellar:testnet takes test money (then `npx provider-kit try` works).
STELLAR_NETWORK=stellar:pubnet

# Mainnet's facilitator settles payments with an API key: get one at https://channels.openzeppelin.com/gen, and write it
# here as "Bearer <key>". Leave it empty on testnet.
FACILITATOR_AUTH=
# A Soroban RPC, to decide uncertain payments from the chain: mainnet has no default. For production traffic, a
# provider's is safer: https://developers.stellar.org/docs/data/apis/rpc/providers
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com

# What a call costs, in USDC.
PRICE_USDC=0.25

# The model that writes headlines: any OpenAI-compatible API. Default: Gemini Flash-Lite (free tier at
# https://aistudio.google.com/apikey). Empty key = headlines from the README, no model, no cost.
# Others: OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=<a :free model>
#         Groq        LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#         Ollama      LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5vl:7b
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Tried when the model is busy. Thinking models answer in 1-3 s with LLM_REASONING_EFFORT=low (Gemini default).
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low
# Send small thumbnails of the screens to the model, so each headline matches its screen. false for text-only models.
LLM_VISION=true

# Optional: a GitHub token with public read access only (5,000 instead of 60 GitHub calls an hour).
GITHUB_TOKEN=
# Where rendered images are kept, and for how long (seconds). Links in a result stay valid this long.
OUTPUT_DIR=./data/outputs
RETENTION_SECONDS=604800
# Jobs rendering at once: each holds a Chromium page about 5 screenshots wide (~400 MB).
RENDER_CONCURRENCY=2
