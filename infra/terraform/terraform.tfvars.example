# Copy to terraform.tfvars (kept out of git) and fill in. The service's own settings come from ../../.env when you
# deploy with `npm run deploy`.
tenancy_ocid     = "ocid1.tenancy.oc1..aaaa..."
compartment_ocid = "ocid1.tenancy.oc1..aaaa..." # the tenancy itself is the root compartment
region           = "eu-frankfurt-1"              # your home region

